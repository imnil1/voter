# Remote browser WebSocket URL from your browserless Railway service
BROWSER_WS_URL=wss://your-browserless-domain.up.railway.app?token=your_token

# Cookie storage directory (set to mounted volume path on Railway)
COOKIE_DIR=/app/cookies

# Timezone in IANA format
TIMEZONE=Asia/Kolkata

# JSON config — per-token schedules and bot IDs
CONFIG={"tokens":[{"token":"YOUR_DISCORD_TOKEN_1","voteAt":["08:50","20:50"]},{"token":"YOUR_DISCORD_TOKEN_2","voteAt":["09:30","21:30"]}],"botIds":["BOT_ID_1","BOT_ID_2"]}
