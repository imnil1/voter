# Remote Camoufox server WebSocket URL, launched via
# camoufox.server.launch_server(...) on CodeSandbox (or wherever the browser
# is hosted). Replaces the old BROWSER_WS_URL/browserless-v2 setup — Camoufox
# is a hardened Firefox build, connected to via Playwright's firefox.connect()
# rather than chromium.connectOverCDP().
CAMOUFOX_WS_URL=ws://your-codesandbox-host:PORT/your-ws-path

# Cookie storage directory (set to mounted volume path on Railway)
COOKIE_DIR=/app/cookies

# Debug screenshot storage directory — saved whenever a vote fails to
# confirm, times out, or Turnstile can't be solved (mount as a volume on
# Railway to persist and inspect them; safe to omit if you don't need this)
SCREENSHOT_DIR=/app/screenshots

# Timezone in IANA format
TIMEZONE=Asia/Kolkata

# Verbose/diagnostic logging (per-iteration Turnstile poll logs, full
# per-cookie detail dumps). Off by default — turn on temporarily while
# actively debugging an issue, then turn back off for normal runs.
# Accepts true/1 (case-insensitive); anything else is treated as off.
VERBOSE_LOGS=false

# NOTE: TURNSTILE_SOLVER_URL / TURNSTILE_SOLVER_KEY are no longer used.
# Turnstile and Cloudflare-interstitial solving now happen in-process via
# playwright-captcha's ClickSolver, directly against the voter's own
# Camoufox page — no separate solver service or API key required.

# JSON config — per-token schedules and bot IDs
# "label" is optional — a readable name for this token, used in logs instead
# of the truncated token prefix. Omit or set "voteAt" to null for a token to
# run it immediately on startup instead of waiting for a scheduled time.
CONFIG={"tokens":[{"label":"main","token":"YOUR_DISCORD_TOKEN_1","voteAt":["08:50","20:50"]},{"label":"alt","token":"YOUR_DISCORD_TOKEN_2"}],"botIds":["BOT_ID_1","BOT_ID_2"]}
