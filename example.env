# Remote browser WebSocket URL from your browserless Railway service
BROWSER_WS_URL=wss://your-browserless-domain.up.railway.app?token=your_token

# Cookie storage directory (set to mounted volume path on Railway)
COOKIE_DIR=/app/cookies

# Timezone in IANA format
TIMEZONE=Asia/Kolkata

# Self-hosted icemellow-me/turnstile-solver service (2captcha-compatible API)
# Deploy as its own Railway service, then point these at it.
TURNSTILE_SOLVER_URL=https://your-turnstile-solver-domain.up.railway.app
TURNSTILE_SOLVER_KEY=your_solver_api_key

# JSON config — per-token schedules and bot IDs
# Omit or set "voteAt" to null for a token to run it immediately on startup
# instead of waiting for a scheduled time (useful for quick testing).
CONFIG={"tokens":[{"token":"YOUR_DISCORD_TOKEN_1","voteAt":["08:50","20:50"]},{"token":"YOUR_DISCORD_TOKEN_2"}],"botIds":["BOT_ID_1","BOT_ID_2"]}
